# Job ingestion — local secrets
# Copy to `.env` and fill in. Never commit `.env`.

# Required for Gemini extraction (the objects shown in Streamlit).
GEMINI_API_KEY=

# Optional. When empty, public JSON/RSS URLs are fetched with a polite HTTP GET.
FIRECRAWL_API_KEY=

# Optional override of the demo source (RemoteOK public API by default).
DEFAULT_SOURCE_URL=https://remoteok.com/api
DEFAULT_SOURCE_NAME=remoteok

GEMINI_MODEL=gemini-2.0-flash
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=3
MIN_REQUEST_INTERVAL_SECONDS=1.5
MAX_JOBS_PER_INGEST=25
SELENIUM_HEADLESS=true
